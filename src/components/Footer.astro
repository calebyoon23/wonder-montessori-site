---
/**
 * Footer.astro — Site footer. No emojis. School info from Sanity.
 */
import { fetchSanity } from '../lib/sanity';
import { Q, FALLBACK } from '../lib/queries';

const siteInfo = await fetchSanity(Q.siteInfo, FALLBACK.siteInfo);
const year = new Date().getFullYear();
---

<footer class="bg-forest text-white/55">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 pt-16 pb-8">

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-14">

      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3 mb-5 group" aria-label="Home">
          <div class="w-9 h-9 rounded-full bg-sage flex items-center justify-center flex-shrink-0">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M9 1.5C6 1.5 3 4.5 3 7.5c0 4.5 4.5 8 6 9 1.5-1 6-4.5 6-9 0-3-3-6-6-6z" fill="#C8DECA" opacity="0.9"/>
              <line x1="9" y1="4.5" x2="9" y2="15" stroke="rgba(122,158,126,0.7)" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="leading-tight">
            <span class="block font-serif text-white font-semibold text-base leading-none">{siteInfo.schoolName}</span>
            <span class="block text-white/35 text-[0.62rem] uppercase tracking-[0.14em] mt-0.5">Est. {siteInfo.established}</span>
          </div>
        </a>
        <p class="font-sans text-sm leading-relaxed max-w-xs mb-6 text-white/50">{siteInfo.tagline} — nurturing curious minds and compassionate hearts since {siteInfo.established}.</p>
        <div class="flex flex-col gap-2 text-sm font-sans">
          <a href={`tel:${siteInfo.phone}`} class="hover:text-white transition-colors flex items-center gap-2.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="text-sage flex-shrink-0" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.5 10.81 19.79 19.79 0 01.46 2.18 2 2 0 012.44 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.18 6.18l.77-.77a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            {siteInfo.phone}
          </a>
          <a href={`mailto:${siteInfo.email}`} class="hover:text-white transition-colors flex items-center gap-2.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="text-sage flex-shrink-0" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
            {siteInfo.email}
          </a>
          <span class="flex items-center gap-2.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="text-sage flex-shrink-0" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {siteInfo.address}
          </span>
        </div>
      </div>

      <!-- Pages -->
      <div>
        <h5 class="text-white text-xs font-semibold uppercase tracking-[0.12em] mb-5 font-sans">Pages</h5>
        <ul class="flex flex-col gap-2.5">
          {[
            { href: '/', label: 'Home' },
            { href: '/about', label: 'About Us' },
            { href: '/programs', label: 'Programs' },
            { href: '/calendar', label: 'Calendar' },
            { href: '/contact', label: 'Schedule a Tour' },
          ].map(l => (
            <li><a href={l.href} class="font-sans text-sm hover:text-white transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Programs -->
      <div>
        <h5 class="text-white text-xs font-semibold uppercase tracking-[0.12em] mb-5 font-sans">Programs</h5>
        <ul class="flex flex-col gap-2.5">
          {[
            'Infant Program',
            "Toddler & Two's",
            'Primary (3–6)',
            'Summer Program',
          ].map(p => (
            <li><a href="/programs" class="font-sans text-sm hover:text-white transition-colors">{p}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 font-sans text-xs text-white/30">
      <span>&copy; {year} {siteInfo.schoolName}. All rights reserved.</span>
      <span>Certified Montessori &middot; Chicago, IL</span>
    </div>
  </div>
</footer>
