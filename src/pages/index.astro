---
/**
 * index.astro — Home Page
 * Sections: Hero · Quote · Programs · Credentials · Story · Tour CTA
 * Facts sourced from the Parent Handbook and 2026–2027 Tuition Plans. No emojis.
 */
import Layout from '../layouts/Layout.astro';
import { SITE as siteInfo, fullAddress } from '../lib/site';
import { getTuition, lowestPrice } from '../lib/pricing';
import { QUOTES, CREDENTIALS } from '../lib/content';
import { PHOTOS, PROGRAM_PHOTOS, photo } from '../lib/images';

const { programs } = await getTuition();

const heroPhoto  = photo(PHOTOS.homeHero);
const quote      = QUOTES.home;
---

<Layout title={`${siteInfo.schoolName} | ${siteInfo.tagline}`}>

  <!-- ══════════════════════════════════════════
       HERO — split layout: type left, photo right
  ══════════════════════════════════════════ -->
  <section class="bg-cream relative overflow-hidden">
    <!-- Decorative orbits, behind everything -->
    <div
      class="absolute w-[560px] h-[560px] rounded-full top-[10%] -left-40 hidden lg:block pointer-events-none"
      style="border: 1px solid rgba(44,62,45,0.07);"
    ></div>
    <div class="absolute -right-32 -top-32 w-[420px] h-[420px] bg-sage/10 rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-10 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center py-10 lg:py-16">

        <!-- Text -->
        <div class="lg:col-span-6">
          <div class="flex items-center gap-3 mb-7">
            <div class="w-8 h-px bg-terracotta flex-shrink-0"></div>
            <span class="font-sans text-terracotta text-[0.68rem] font-semibold uppercase tracking-[0.18em]">
              Chicago, IL &nbsp;&middot;&nbsp; Est. {siteInfo.established}
            </span>
          </div>

          <h1 class="font-serif text-[2.5rem] sm:text-[3.25rem] lg:text-[3.75rem] text-forest leading-[1.05] mb-8">
            A place where<br />every child<br /><em class="italic text-sage">belongs</em>
          </h1>

          <div class="flex flex-wrap gap-4">
            <a href="/contact" class="btn-terracotta">Schedule a Tour</a>
            <a href="/programs" class="btn-outline">Explore Programs</a>
          </div>
        </div>

        <!-- Photo -->
        <div class="lg:col-span-6 relative">
          {heroPhoto ? (
            <div class="relative">
              <img
                src={heroPhoto.src}
                alt={heroPhoto.alt}
                class="w-full h-[240px] sm:h-[340px] lg:h-[420px] object-cover rounded-[2rem] shadow-[0_24px_70px_rgba(44,62,45,0.18)]"
                width="1400" height="1062"
                loading="eager"
              />
            </div>
          ) : (
            <div class="rounded-[2rem] bg-sand h-[420px] flex items-center justify-center">
              <span class="font-sans text-[var(--muted)] text-sm">Photograph coming soon</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       MONTESSORI QUOTE
  ══════════════════════════════════════════ -->
  <section class="bg-forest py-20 md:py-24 px-6">
    <figure class="max-w-3xl mx-auto text-center reveal">
      <div class="w-10 h-px bg-sage-light/60 mx-auto mb-8"></div>
      <blockquote class="font-serif italic text-2xl md:text-[2rem] text-white leading-[1.45]">
        “{quote.text}”
      </blockquote>
      <figcaption class="font-sans text-white/55 text-xs uppercase tracking-[0.18em] mt-7">
        {quote.attribution}
      </figcaption>
    </figure>
  </section>


  <!-- ══════════════════════════════════════════
       PROGRAMS PREVIEW — three programs
  ══════════════════════════════════════════ -->
  <section class="bg-sand py-24 md:py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-6 mb-12 reveal">
        <div>
          <div class="section-divider">
            <span class="section-tag" style="margin-bottom:0">Programs</span>
          </div>
          <h2 class="font-serif text-4xl md:text-5xl text-forest leading-[1.1]">
            Three programs,<br /><em class="italic text-sage">three months to six years</em>
          </h2>
        </div>
        <a href="/programs" class="btn-outline flex-shrink-0">View All Programs</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {programs.map((prog, i) => {
          const img = PROGRAM_PHOTOS[prog.slug];
          return (
            <a
              href="/programs"
              class={`card-hover reveal reveal-delay-${i} block bg-white rounded-3xl overflow-hidden border border-[rgba(44,62,45,0.07)]`}
            >
              <div class="relative h-52">
                {img?.ready ? (
                  <img src={img.src} alt={img.alt} class="w-full h-full object-cover" width="800" height="533" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-sage-light"></div>
                )}
                <div class="absolute inset-0 overlay-forest-top"></div>
                <div class="absolute bottom-4 left-5 right-5">
                  <span class="font-sans text-white/75 text-[0.66rem] uppercase tracking-[0.14em]">{prog.ageRange}</span>
                </div>
              </div>
              <div class="p-6 flex items-baseline justify-between gap-4">
                <h3 class="font-serif text-xl text-forest">{prog.name}</h3>
                <span class="font-sans text-sage text-xs font-semibold uppercase tracking-wider whitespace-nowrap">
                  From {lowestPrice(prog)}
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       CREDENTIALS — dark forest section
  ══════════════════════════════════════════ -->
  <section class="bg-forest py-24 md:py-28 px-6 relative overflow-hidden">
    <div class="absolute right-0 top-0 w-[500px] h-[500px] border border-white/5 rounded-full -translate-y-1/3 translate-x-1/3"></div>
    <div class="absolute left-0 bottom-0 w-[300px] h-[300px] bg-sage/8 rounded-full translate-y-1/3 -translate-x-1/3"></div>

    <div class="max-w-6xl mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-16 items-center">

      <div class="reveal">
        <div class="section-divider">
          <span class="section-tag" style="color:#C8DECA; margin-bottom:0">Faculty &amp; Credentials</span>
        </div>
        <h2 class="font-serif text-4xl md:text-5xl text-white mb-6 leading-[1.1]">
          Taught by trained<br /><em class="italic text-sage-light">Montessori educators</em>
        </h2>
        <p class="font-sans text-white/60 leading-relaxed mb-5">
          Our teachers hold Early Childhood Education credentials and Montessori
          credentials, and our head directresses are certified by accredited
          educational institutions.
        </p>
        <p class="font-sans text-white/60 leading-relaxed mb-8">
          Wonder Montessori is a full member of the
          <strong class="text-white">American Montessori Society (AMS)</strong>
          and the Association of Illinois Montessori Schools.
        </p>
        <a href="/about" class="btn-white">More About Our School</a>
      </div>

      <div class="reveal reveal-delay-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {CREDENTIALS.map((card, i) => (
          <div class={`reveal reveal-delay-${i} bg-white/6 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors duration-300`}>
            <div class="w-8 h-0.5 bg-sage mb-4"></div>
            <h3 class="font-serif text-base text-white mb-2">{card.title}</h3>
            <p class="font-sans text-white/50 text-xs leading-relaxed">{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       OUR STORY — type-led, no photo
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-24 md:py-28 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12 reveal">
        <div class="section-divider justify-center">
          <span class="section-tag" style="margin-bottom:0">Our Story</span>
        </div>
        <h2 class="font-serif text-4xl md:text-5xl text-forest leading-[1.1]">
          Founded in 1993<br />by two <em class="italic text-sage">educators</em>
        </h2>
      </div>

      <div class="reveal reveal-delay-1 bg-white rounded-[2rem] border border-[rgba(44,62,45,0.07)] p-8 md:p-12 relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sage to-terracotta"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 items-center">
          <div>
            <p class="font-sans text-[var(--muted)] leading-relaxed mb-4">
              Dr. Peter and Gwen Ku were both educated in Seoul and the United States, earning
              bachelor’s and master’s degrees in education. After further Montessori training,
              Gwen taught in suburban Montessori schools and noticed how few of them served
              a genuinely diverse student body.
            </p>
            <p class="font-sans text-[var(--muted)] leading-relaxed">
              They opened Wonder Montessori in October 1993 with two three-to-six classrooms
              on North Pulaski Road. At the request of families, the school grew to add a
              Toddler &amp; Two’s program and an Infant &amp; Toddlers program.
            </p>
          </div>

          <div class="md:border-l md:border-[rgba(44,62,45,0.1)] md:pl-12">
            <blockquote class="font-serif italic text-lg md:text-xl text-forest leading-relaxed mb-5">
              “We desired to open a school that would provide a quality Montessori education
              to a population reflective of today’s society.”
            </blockquote>
            <cite class="not-italic font-sans text-[var(--muted)] text-xs uppercase tracking-[0.14em] block mb-7">
              Dr. Peter &amp; Gwen Ku, Founders
            </cite>
            <a href="/about" class="btn-outline">Read Our Story</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       TOUR CTA
  ══════════════════════════════════════════ -->
  <section class="bg-sage py-24 md:py-28 px-6 text-center relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] border border-white/10 rounded-full pointer-events-none animate-[orbit_35s_linear_infinite]"></div>

    <div class="relative z-10 max-w-xl mx-auto reveal">
      <div class="section-divider justify-center">
        <span class="section-tag" style="color:rgba(255,255,255,0.75); margin-bottom:0">Come Visit Us</span>
      </div>
      <h2 class="font-serif text-4xl md:text-5xl text-white mb-5 leading-[1.1]">
        We'd love to show<br />you around
      </h2>
      <p class="font-sans text-white/75 text-lg leading-relaxed mb-4">
        Tours take about 25–30 minutes.
      </p>
      <p class="font-sans text-white/60 text-sm leading-relaxed mb-9">
        We highly prefer that parents bring their child along.
      </p>
      <div class="flex justify-center">
        <a href="/contact" class="btn-white">Schedule a Tour</a>
      </div>
      <p class="font-sans text-white/50 text-xs mt-7">{fullAddress(siteInfo)}</p>
    </div>
  </section>

</Layout>
