---
/**
 * programs.astro — Programs, Curriculum & Tuition
 * Three programs only. Every tuition figure comes from the 2026–2027 Tuition Plans
 * document via queries.ts — do not hardcode prices in this file.
 */
import Layout from '../layouts/Layout.astro';
import { fetchSanity } from '../lib/sanity';
import { Q, FALLBACK } from '../lib/queries';
import { QUOTES, CURRICULUM_AREAS } from '../lib/content';
import { PROGRAM_PHOTOS } from '../lib/images';

const siteInfo = await fetchSanity(Q.siteInfo, FALLBACK.siteInfo);
const programs = await fetchSanity(Q.programs, FALLBACK.programs);
const quote    = QUOTES.programs;
---

<Layout
  title={`Programs & Tuition | ${siteInfo.schoolName}`}
  description="Wonder Montessori's three programs in Chicago, IL: Infant & Toddlers (3–15 months), Toddler & Two's (15–36 months), and 3–6 Primary, with 2026–2027 tuition."
>

  <!-- ══════════════════════════════════════════
       HERO — type-led
  ══════════════════════════════════════════ -->
  <section class="bg-forest py-20 md:py-24 px-6 relative overflow-hidden">
    <div class="absolute right-0 top-0 w-96 h-96 bg-sage/8 rounded-full translate-x-1/3 -translate-y-1/3"></div>
    <div class="absolute left-1/4 bottom-0 w-72 h-72 border border-white/5 rounded-full translate-y-1/2"></div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="section-divider">
        <span class="section-tag" style="color:rgba(200,222,202,0.85); margin-bottom:0">Academic Programs</span>
      </div>
      <h1 class="font-serif text-[2.75rem] sm:text-5xl md:text-6xl text-white leading-[1.06] max-w-3xl mb-10">
        A program for every<br /><em class="italic text-sage-light">stage of wonder</em>
      </h1>
      <!-- Quick jump chips -->
      <div class="flex flex-wrap gap-3">
        {programs.map(p => (
          <a
            href={`#${p.slug}`}
            class="inline-flex items-baseline gap-2 rounded-full border border-white/20 px-5 py-2.5 hover:bg-white/10 hover:border-white/40 transition-colors"
          >
            <span class="font-sans text-white text-sm font-medium">{p.name}</span>
            <span class="font-sans text-white/45 text-xs">{p.ageRange}</span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       PROGRAMS — one block each, with schedules
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-24 md:py-28 px-6">
    <div class="max-w-6xl mx-auto flex flex-col gap-20 md:gap-28">
      {programs.map((prog, i) => {
        const img = PROGRAM_PHOTOS[prog.slug];
        return (
          <article id={prog.slug} class="reveal scroll-mt-28">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">

              <!-- Photo -->
              <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
                {img?.ready ? (
                  <img
                    src={img.src}
                    alt={img.alt}
                    class="w-full h-72 md:h-[26rem] object-cover rounded-[2rem]"
                    width="800" height="533" loading="lazy"
                  />
                ) : (
                  <div class="w-full h-72 md:h-[26rem] bg-sand rounded-[2rem]"></div>
                )}
              </div>

              <!-- Copy + tuition -->
              <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
                <div class="w-8 h-0.5 bg-terracotta mb-5"></div>
                <h2 class="font-serif text-3xl md:text-4xl text-forest mb-2 leading-tight">{prog.name}</h2>
                <p class="font-sans text-sage text-sm font-semibold uppercase tracking-[0.14em] mb-8">{prog.ageRange}</p>

                <!-- Schedules & tuition -->
                <div class="bg-white rounded-3xl border border-[rgba(44,62,45,0.08)] overflow-hidden">
                  <div class="flex items-baseline justify-between gap-4 px-6 py-4 border-b border-[rgba(44,62,45,0.08)] bg-sand/40">
                    <h3 class="font-serif text-base text-forest">Schedules &amp; Monthly Tuition</h3>
                    <span class="font-sans text-[var(--muted)] text-[0.65rem] uppercase tracking-[0.12em]">2026–2027</span>
                  </div>

                  <table class="w-full">
                    <caption class="sr-only">{prog.name} schedule options and monthly tuition for 2026–2027</caption>
                    <thead class="sr-only">
                      <tr><th scope="col">Schedule</th><th scope="col">Hours</th><th scope="col">Monthly tuition</th></tr>
                    </thead>
                    <tbody>
                      {prog.plans.map(plan => (
                        <tr class="border-b border-[rgba(44,62,45,0.06)] last:border-0">
                          <th scope="row" class="text-left font-sans font-medium text-forest text-sm px-6 py-4">
                            {plan.label}
                            <span class="block font-normal text-[var(--muted)] text-xs mt-0.5">{plan.hours}</span>
                          </th>
                          <td class="px-6 py-4 text-right font-serif text-xl font-bold text-forest whitespace-nowrap">
                            {plan.price}
                            <span class="font-sans text-[var(--muted)] text-[0.65rem] font-normal">/mo</span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       MONTESSORI QUOTE
  ══════════════════════════════════════════ -->
  <section class="bg-sage py-20 px-6">
    <figure class="max-w-3xl mx-auto text-center reveal">
      <div class="w-10 h-px bg-white/50 mx-auto mb-8"></div>
      <blockquote class="font-serif italic text-2xl md:text-[1.9rem] text-white leading-[1.45]">
        “{quote.text}”
      </blockquote>
      <figcaption class="font-sans text-white/65 text-xs uppercase tracking-[0.18em] mt-7">
        {quote.attribution}
      </figcaption>
    </figure>
  </section>


  <!-- ══════════════════════════════════════════
       CURRICULUM
  ══════════════════════════════════════════ -->
  <section class="bg-cream py-24 md:py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14 reveal">
        <div class="section-divider justify-center">
          <span class="section-tag" style="margin-bottom:0">The Montessori Curriculum</span>
        </div>
        <h2 class="font-serif text-4xl md:text-5xl text-forest leading-[1.1]">
          Tailored to each child.<br /><em class="italic text-sage">Not one-size-fits-all.</em>
        </h2>
        <p class="font-sans text-[var(--muted)] leading-relaxed max-w-xl mx-auto mt-5">
          A child is never forced to take part in an activity. They are gently guided and
          offered alternatives. These areas begin in earnest in Toddler &amp; Two’s and 3–6
          Primary, with introductory lessons at the Infant &amp; Toddlers level.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {CURRICULUM_AREAS.map((area, i) => (
          <div class={`reveal reveal-delay-${i % 3} bg-white rounded-2xl p-7 border border-[rgba(44,62,45,0.07)] card-hover`}>
            <div class="w-6 h-0.5 bg-sage mb-4"></div>
            <h3 class="font-serif text-lg text-forest mb-2.5">{area.title}</h3>
            <p class="font-sans text-[var(--muted)] text-sm leading-relaxed">{area.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="bg-forest py-24 px-6 text-center relative overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-[500px] h-[500px] border border-white/5 rounded-full animate-[orbit_35s_linear_infinite]"></div>
    </div>
    <div class="relative z-10 max-w-xl mx-auto reveal">
      <h2 class="font-serif text-4xl text-white mb-4">Ready to find the right fit?</h2>
      <p class="font-sans text-white/60 leading-relaxed mb-8">
        Come in for a tour and we'll walk you through the right program for your child's
        age and needs. Tours take 25–30 minutes, and we highly prefer that parents bring
        their child along.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contact" class="btn-white">Schedule a Tour</a>
        <a href={`tel:${siteInfo.phone}`} class="btn-outline-white">{siteInfo.phone}</a>
      </div>
    </div>
  </section>

</Layout>
