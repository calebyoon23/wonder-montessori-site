---
/**
 * calendar.astro — Calendar
 * Deliberately minimal: a heading and the school's Google Calendar, nothing else.
 * Staff manage every closing, holiday, and event from Google Calendar without
 * touching this site. The calendar ID lives in siteInfo (content/site-info.json).
 */
import Layout from '../layouts/Layout.astro';
import { fetchSanity } from '../lib/sanity';
import { Q, FALLBACK } from '../lib/queries';

const siteInfo = await fetchSanity(Q.siteInfo, FALLBACK.siteInfo);

// Google Calendar embed. Colors are set to the school palette; `showTabs` lets
// visitors switch between month, week, and agenda views.
const calendarParams = new URLSearchParams({
  src: siteInfo.calendarId,
  ctz: siteInfo.timezone,
  wkst: '1',            // weeks start on Sunday
  bgcolor: '#FFFFFF',
  color: '#2C3E2D',     // forest, used for event chips
  mode: 'MONTH',
  showTitle: '0',
  showPrint: '0',
  showCalendars: '0',
  showTz: '0',
  showNav: '1',
  showDate: '1',
  showTabs: '1',
});
const calendarSrc = `https://calendar.google.com/calendar/embed?${calendarParams.toString()}`;
const hasCalendar = Boolean(siteInfo.calendarId);
---

<Layout
  title={`Calendar | ${siteInfo.schoolName}`}
  description="School closings, holidays, and important events at Wonder Montessori School in Chicago, IL."
>

  <section class="bg-cream py-14 md:py-20 px-6">
    <div class="max-w-6xl mx-auto">

      <h1 class="font-serif text-4xl md:text-5xl text-forest leading-tight mb-10 md:mb-12">
        Browse the year
      </h1>

      <div class="bg-white rounded-[2rem] border border-[rgba(44,62,45,0.08)] p-3 sm:p-5 shadow-[0_4px_24px_rgba(44,62,45,0.06)]">
        {hasCalendar ? (
          <div class="calendar-embed">
            <iframe
              src={calendarSrc}
              title={`${siteInfo.schoolName} school calendar`}
              loading="lazy"
              frameborder="0"
              scrolling="no"
            ></iframe>
          </div>
        ) : (
          <div class="py-20 text-center">
            <p class="font-serif text-forest text-lg mb-2">Calendar coming soon</p>
            <p class="font-sans text-[var(--muted)] text-sm">
              Please <a href="/contact" class="text-sage underline underline-offset-2">contact the school</a> for term dates and closings.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

</Layout>
