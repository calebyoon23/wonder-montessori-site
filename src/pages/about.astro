---
/**
 * about.astro — About Wonder Montessori
 * Sections: Hero · Our Founders · What We Stand For
 * All content traces to the Parent Handbook (Rev. 08/24).
 *
 * Colour rhythm runs light to warm so each band separates from the next:
 *   cream (hero) → white (founders) → sand (mission) → forest (footer)
 */
import Layout from '../layouts/Layout.astro';
import { SITE as siteInfo, FOUNDERS } from '../lib/site';

/** "Dr. Gwen Ku" -> "GK". Honorifics are dropped so the monogram reads cleanly. */
const initials = (name: string) =>
  name.replace(/^(Dr|Mr|Mrs|Ms|Prof)\.?\s+/i, '')
      .split(/\s+/)
      .map(w => w[0])
      .join('')
      .slice(0, 2)
      .toUpperCase();

const pillars = [
  {
    num: '01',
    label: 'Mission',
    accent: 'bg-terracotta',
    body: 'To create an educational environment, following the Montessori philosophy, that nurtures every child to become a creative, competent, and confident learner, by promoting cultural and ethnic diversity and encouraging each child’s inner academic, emotional, and social potential.',
  },
  {
    num: '02',
    label: 'Vision',
    accent: 'bg-sage',
    body: 'To build a thriving educational community where children learn from and respect one another, and where our teachers and staff work to develop each child’s academic potential.',
  },
  {
    num: '03',
    label: 'Purpose',
    accent: 'bg-forest',
    body: 'To provide an environment where children are comfortable and yet challenged to do their very best, leaving us not only strong in academics but well-rounded in emotional, social, and character development.',
  },
];
---

<Layout
  title={`About Us | ${siteInfo.schoolName}`}
  description="Wonder Montessori School is a 501(c)(3) non-profit, non-sectarian Montessori school in Chicago, IL, founded in 1993 and a member of the American Montessori Society."
>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="bg-cream pt-16 pb-14 md:pt-20 md:pb-16 px-6 relative overflow-hidden">
    <div class="absolute -right-28 -top-28 w-[440px] h-[440px] bg-sage/10 rounded-full pointer-events-none"></div>
    <div class="absolute right-24 top-16 w-56 h-56 border border-forest/5 rounded-full pointer-events-none hidden md:block"></div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="section-divider">
        <span class="section-tag" style="margin-bottom:0">About Us</span>
      </div>
      <h1 class="font-serif text-[2.75rem] sm:text-5xl md:text-6xl text-forest leading-[1.06] max-w-3xl mb-7">
        A school built on<br /><em class="italic text-sage">community and care</em>
      </h1>
      <p class="font-sans text-[var(--muted)] text-lg leading-relaxed max-w-2xl">
        Wonder Montessori School is an independent 501(c)(3) non-profit and a
        non-sectarian school on Chicago’s north side.
      </p>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       OUR FOUNDERS
  ══════════════════════════════════════════ -->
  <section class="bg-white py-24 md:py-28 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14 reveal">
        <div class="section-divider justify-center">
          <span class="section-tag" style="margin-bottom:0">Our Founders</span>
        </div>
        <h2 class="font-serif text-4xl md:text-5xl text-forest leading-[1.1]">
          Built by educators.<br /><em class="italic text-sage">Driven by purpose.</em>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {FOUNDERS.map((member, i) => (
          <article class={`reveal reveal-delay-${i} card-hover bg-cream rounded-[1.75rem] p-8 border border-[rgba(44,62,45,0.08)] relative overflow-hidden`}>
            <!-- Top accent -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sage to-terracotta"></div>

            <!-- Monogram -->
            <div class="w-16 h-16 rounded-full bg-sage-light border border-sage/30 flex items-center justify-center mb-6 overflow-hidden">
              <span class="font-serif text-forest text-lg font-bold tracking-wide">{initials(member.name)}</span>
            </div>

            <h3 class="font-serif text-2xl text-forest mb-1.5 leading-tight">{member.name}</h3>
            <div class="font-sans text-terracotta text-[0.68rem] font-semibold uppercase tracking-[0.16em] mb-5">
              {member.title}
            </div>
            <div class="w-8 h-px bg-[rgba(44,62,45,0.15)] mb-5"></div>
            <p class="font-sans text-[var(--muted)] text-sm leading-relaxed">{member.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       WHAT WE STAND FOR
  ══════════════════════════════════════════ -->
  <section class="bg-sand py-24 md:py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14 reveal">
        <div class="section-divider justify-center">
          <span class="section-tag" style="margin-bottom:0">What We Stand For</span>
        </div>
        <h2 class="font-serif text-4xl md:text-5xl text-forest leading-[1.1]">
          The same mission<br /><em class="italic text-sage">since we opened</em>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {pillars.map((item, i) => (
          <div class={`reveal reveal-delay-${i} bg-white rounded-[1.75rem] p-8 border border-[rgba(44,62,45,0.07)] card-hover flex flex-col`}>
            <div class="flex items-center gap-3 mb-5">
              <span class={`${item.accent} w-8 h-0.5 flex-shrink-0`}></span>
              <span class="font-sans text-[var(--muted)] text-[0.68rem] font-semibold tracking-[0.16em]">{item.num}</span>
            </div>
            <h3 class="font-serif text-2xl text-forest mb-3.5 leading-tight">{item.label}</h3>
            <p class="font-sans text-[var(--muted)] text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>
